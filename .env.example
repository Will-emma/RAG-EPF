# ==== Base de données ====
POSTGRES_USER=epf_rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=epf_rag
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://epf_rag:change_me@db:5432/epf_rag

# ==== Auth ====
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==== LLM (OpenRouter, modèles gratuits - chacun utilise sa propre clé) ====
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.2:free

# ==== Embeddings ====
# Option 1 (recommandé, gratuit, local) : sentence-transformers
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Option 2 : API Mistral (si quota gratuit dispo)
MISTRAL_API_KEY=

# ==== App ====
ENV=dev
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.pptx,.docx
CORS_ORIGINS=http://localhost:4200
