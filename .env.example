# Copiez ce fichier en .env à la racine du repo (cp .env.example .env).
# Après toute modification du .env : `docker compose up -d` (un simple
# `docker restart` ne relit pas le fichier).

# ==== Base de données ====
# Si vous changez POSTGRES_PASSWORD, changez-le aussi dans DATABASE_URL.
POSTGRES_USER=epf_rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=epf_rag
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://epf_rag:change_me@db:5432/epf_rag

# ==== Auth ====
# Mettez une longue chaîne aléatoire (ex : python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
# Durée de session : au-delà, le frontend renvoie automatiquement vers /login
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==== LLM (OpenRouter, modèles gratuits - chacun utilise sa propre clé) ====
# Clé gratuite : https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Les modèles ":free" changent souvent (404 = modèle retiré, 429 = saturé).
# Liste à jour : https://openrouter.ai/api/v1/models
# Secours gratuit : dots-studio/dots-3-note-preview:free (QCM lent)
# Secours payant (crédit OpenRouter requis) : z-ai/glm-5.2
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ==== Embeddings ====
# Option 1 (recommandé, gratuit, local) : sentence-transformers
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Option 2 : API Mistral (si quota gratuit dispo)
MISTRAL_API_KEY=

# ==== App ====
ENV=dev
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.pptx,.docx
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:4200
